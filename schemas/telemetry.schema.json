{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Gecesars/18-gateway-industrial/schemas/telemetry.schema.json",
  "title": "EDGE telemetry envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "device_id", "boot_id", "message_id", "sent_at_ms", "points"],
  "properties": {
    "schema": {"const": "edge.telemetry/1"},
    "device_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,47}$"},
    "boot_id": {"type": "string", "pattern": "^[0-9a-f]{8,32}$"},
    "message_id": {"type": "string", "pattern": "^[0-9a-f]{16}$"},
    "sent_at_ms": {"type": "integer", "minimum": 0},
    "points": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["point_id", "sequence", "timestamp_ms", "monotonic_ms", "value_type", "value", "unit", "quality", "source", "config_revision"],
        "properties": {
          "point_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,47}$"},
          "sequence": {"type": "integer", "minimum": 0},
          "timestamp_ms": {"type": "integer", "minimum": 0},
          "monotonic_ms": {"type": "integer", "minimum": 0},
          "value_type": {"enum": ["bool", "i64", "u64", "f64", "string"]},
          "value": {"type": ["boolean", "integer", "number", "string"]},
          "unit": {"type": "string", "maxLength": 16},
          "quality": {"type": "integer", "minimum": 0, "maximum": 4294967295},
          "source": {"type": "string", "maxLength": 32},
          "config_revision": {"type": "integer", "minimum": 1, "maximum": 4294967295}
        }
      }
    }
  }
}
